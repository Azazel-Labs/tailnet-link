{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tailnet Link: App",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin", "tailnet-link", "--locked"],
        "filter": { "name": "tailnet-link", "kind": "bin" }
      },
      "windows": {
        "cargo": {
          "args": ["build", "--bin", "tailnet-link", "--locked", "--target", "x86_64-pc-windows-gnu"],
          "filter": { "name": "tailnet-link", "kind": "bin" }
        }
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tailnet Link: App (release)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--release", "--bin", "tailnet-link", "--locked"],
        "filter": { "name": "tailnet-link", "kind": "bin" }
      },
      "windows": {
        "cargo": {
          "args": ["build", "--release", "--bin", "tailnet-link", "--locked", "--target", "x86_64-pc-windows-gnu"],
          "filter": { "name": "tailnet-link", "kind": "bin" }
        }
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
